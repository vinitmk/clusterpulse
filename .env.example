# ClusterPulse Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git — it's in .gitignore

# ── Anthropic AI ──────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# ── Email Alerting (Gmail) ────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your regular Gmail password
# Create one at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Database ──────────────────────────────────────────────────────────────────
# These are used by docker-compose.yml
# Default values work out of the box — only change if you have conflicts
POSTGRES_DB=clusterpulse
POSTGRES_USER=clusterpulse
POSTGRES_PASSWORD=clusterpulse